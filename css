
:root {
    --black: #080808;
    --dark: #111111;
    --gold: #c9a96e;
    --gold-light: #e4c477;
    --white: #ffffff;
    --gray: #aaaaaa;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    font-family: "Cairo", sans-serif;
    color: var(--white);
    overflow-x: hidden;

    background:
        radial-gradient(
            circle at 50% 10%,
            rgba(201, 169, 110, 0.13),
            transparent 35%
        ),
        linear-gradient(135deg, #050505, #151515, #070707);
}

.bg-circle {
    position: fixed;
    border: 1px solid rgba(201, 169, 110, 0.13);
    border-radius: 50%;
    pointer-events: none;
}

.circle-1 {
    width: 450px;
    height: 450px;
    top: -230px;
    left: -180px;
}

.circle-2 {
    width: 550px;
    height: 550px;
    bottom: -320px;
    right: -220px;
}

.page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 30px 15px;
    position: relative;
    z-index: 2;
}

.card {
    width: 100%;
    max-width: 520px;
    padding: 45px 35px 30px;
    text-align: center;

    background: rgba(17, 17, 17, 0.92);
    border: 1px solid rgba(201, 169, 110, 0.35);
    border-radius: 28px;

    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);

    backdrop-filter: blur(15px);

    animation: appear 0.8s ease both;
}

.top-line {
    width: 80px;
    height: 3px;
    margin: 0 auto 30px;

    background: linear-gradient(
        90deg,
        transparent,
        var(--gold),
        transparent
    );
}

/* LOGO FRAME */

.logo-box {
    width: 125px;
    height: 125px;
    margin: 0 auto 25px;
    padding: 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(201, 169, 110, 0.65);
    border-radius: 50%;
    background: #0b0b0b;

    box-shadow: 0 0 35px rgba(201, 169, 110, 0.09);

    overflow: hidden;
    position: relative;
}

.logo-box::before {
    content: "";
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(201, 169, 110, 0.25);
    border-radius: 50%;
    pointer-events: none;
}

.logo-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 1;
}

/* COMPANY NAME */

h1 {
    font-family: "Playfair Display", serif;
    font-size: 43px;
    letter-spacing: 4px;
    line-height: 1.3;
    margin-bottom: 5px;
}

.subtitle {
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 5px;
    font-weight: 600;
}

.gold-line {
    width: 45px;
    height: 2px;
    background: var(--gold);
    margin: 20px auto;
}

.description {
    color: var(--gray);
    font-size: 14px;
    line-height: 2;
    max-width: 400px;
    margin: 0 auto 30px;
}

/* BUTTONS */

.buttons {
    display: flex;
    flex-direction: column;
    gap: 13px;
}

.btn {
    min-height: 60px;
    width: 100%;
    padding: 0 18px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    text-decoration: none;
    color: var(--white);

    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 13px;

    font-size: 14px;
    font-weight: 700;

    transition: 0.3s ease;
}

.btn:hover {
    transform: translateY(-3px);
    border-color: var(--gold);
    color: var(--gold-light);
    background: rgba(201, 169, 110, 0.07);
}

.btn-primary {
    background: linear-gradient(
        135deg,
        var(--gold-light),
        var(--gold)
    );

    color: #111;
    border-color: transparent;
}

.btn-primary:hover {
    color: #111;
    background: linear-gradient(135deg, #edd18e, var(--gold-light));
    box-shadow: 0 12px 30px rgba(201, 169, 110, 0.2);
}

.icon {
    width: 25px;
    font-size: 20px;
    text-align: center;
}

.arrow {
    font-size: 18px;
    transition: 0.3s ease;
}

.btn:hover .arrow {
    transform: translateX(-5px);
}

/* FOOTER */

.footer {
    margin-top: 28px;
    padding-top: 20px;

    border-top: 1px solid rgba(255, 255, 255, 0.07);

    color: #777;
    font-size: 10px;
    line-height: 1.8;
}

.footer span {
    color: var(--gold);
    font-weight: 700;
    letter-spacing: 2px;
}

/* ANIMATION */

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* MOBILE */

@media (max-width: 600px) {
    .page {
        padding: 18px 12px;
    }

    .card {
        padding: 35px 20px 25px;
        border-radius: 22px;
    }

    .logo-box {
        width: 110px;
        height: 110px;
    }

    h1 {
        font-size: 34px;
        letter-spacing: 3px;
    }

    .subtitle {
        font-size: 9px;
        letter-spacing: 4px;
    }

    .description {
        font-size: 13px;
    }

    .btn {
        min-height: 56px;
        font-size: 13px;
    }
}

@media (max-width: 360px) {
    h1 {
        font-size: 29px;
    }

    .card {
        padding: 30px 16px 22px;
    }
}
